@using EmployeeManagement.Web.Helpers
@model EmployeeManagement.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var maxCount = Model.Departments.Count == 0 ? 1 : Model.Departments.Max(d => d.EmployeeCount);
}

<section class="hero">
    <h1>@Model.TotalEmployees @(Model.TotalEmployees == 1 ? "person" : "people") across @Model.TotalDepartments @(Model.TotalDepartments == 1 ? "department" : "departments")</h1>
    <p>The average monthly salary is @Model.AverageMonthlySalary.ToString("N2").</p>
</section>

<div class="dash">
    <section class="panel panel-pad">
        <h2>Headcount by department</h2>
        @if (!Model.Departments.Any())
        {
        <p class="muted">No employees yet. <a asp-controller="Employees" asp-action="Create">Add the first employee</a> to see the breakdown.</p>
        }
        else
        {
            for (var i = 0; i < Model.Departments.Count; i++)
            {
                var d = Model.Departments[i];
                var pct = d.EmployeeCount * 100 / maxCount;
        <div class="dept">
            <span class="dept-name">@d.Name</span>
            <div class="bar"><span class="@(d.EmployeeCount == maxCount ? "lead" : "")" style="width:@pct%;animation-delay:@(i * 70)ms"></span></div>
            <div class="dept-meta">
                <b>@d.EmployeeCount</b>
                <small>@d.TotalMonthlySalary.ToString("N0")</small>
            </div>
        </div>
            }
        }
    </section>

    <section class="panel panel-pad">
        <h2>Recent hires</h2>
        @if (!Model.RecentHires.Any())
        {
        <p class="muted">Nobody has been added yet.</p>
        }
        else
        {
        <ul class="hires">
            @foreach (var e in Model.RecentHires)
                {
            <li>
                <span class="avatar" style="@Ui.AvatarStyle(e.FullName)">@Ui.Initials(e.FullName)</span>
                <div>
                    <b>@e.FullName</b>
                    <small>@e.Department?.Name</small>
                </div>
                <time>@e.JoinedOn.ToString("dd MMM yyyy")</time>
            </li>
                }
        </ul>
        }
    </section>
</div>