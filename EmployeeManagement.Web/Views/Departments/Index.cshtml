@model List<EmployeeManagement.Web.Models.Department>
    @{
    ViewData["Title"] = "Departments";
    }

    <div class="page-head">
        <h1>Departments</h1>
        <a asp-action="Create" class="btn btn-primary">Add department</a>
    </div>

    <div class="panel">
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Location</th>
                        <th class="num">Employees</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                {
                    <tr>
                        <td><b>@d.Name</b></td>
                        <td>@d.Location</td>
                        <td class="num">@d.Employees.Count</td>
                        <td>
                            <div class="acts">
                                <a asp-action="Edit" asp-route-id="@d.Id">Edit</a>
                                @if (User.IsInRole("Admin"))
                                {
                                <a class="danger" asp-action="Delete" asp-route-id="@d.Id">Delete</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
