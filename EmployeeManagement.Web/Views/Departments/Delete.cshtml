@model EmployeeManagement.Web.Models.Department
@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Location</dd>

    <dt class="col-sm-3">Employees</dt>
    <dd class="col-sm-9">@Model.Employees.Count</dd>
</dl>

@if (Model.Employees.Any())
{
<div class="alert alert-warning">
    This department still has employees, so it can't be deleted. Move or delete them first.
</div>
<a asp-action="Index" class="btn btn-secondary">Back</a>
}
else
{
<h4 class="text-danger">Are you sure you want to delete this department?</h4>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
}