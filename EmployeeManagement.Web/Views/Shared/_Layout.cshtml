@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var email = User.Identity?.Name ?? "";
    string Active(string c) => ctrl == c ? "active" : "";
    string Current(string c) => ctrl == c ? "page" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staffroom</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="side" id="side">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">S</span>
                <span>Staffroom</span>
            </a>

            <nav class="side-nav" aria-label="Main">
                <a class="side-link @Active("Home")" asp-controller="Home" asp-action="Index" aria-current="@Current("Home")">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a class="side-link @Active("Employees")" asp-controller="Employees" asp-action="Index" aria-current="@Current("Employees")">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    Employees
                </a>
                <a class="side-link @Active("Departments")" asp-controller="Departments" asp-action="Index" aria-current="@Current("Departments")">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2" /><path d="M9 22v-4h6v4" /><path d="M8 6h.01M12 6h.01M16 6h.01M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01" /></svg>
                    Departments
                </a>
                @if (User.IsInRole("Admin"))
                {
                <a class="side-link @Active("Users")" asp-controller="Users" asp-action="Index" aria-current="@Current("Users")">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Users
                </a>
                }
            </nav>

            <div class="side-foot">
                @if (signedIn)
                {
                <div class="who">
                    <span class="avatar" aria-hidden="true">@(email.Length > 0 ? email.Substring(0, 1).ToUpperInvariant() : "?")</span>
                    <div>
                        <b title="@email">@email</b>
                        <small>@(User.IsInRole("Admin") ? "Admin" : "User")</small>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="side-link">
                        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Log out
                    </button>
                </form>
                }
                else
                {
                <a class="side-link" asp-controller="Account" asp-action="Login">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>
                    Log in
                </a>
                <a class="side-link" asp-controller="Account" asp-action="Register">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                    Create account
                </a>
                }
            </div>
        </aside>

        <div class="scrim" id="scrim"></div>

        <div class="main">
            <header class="topbar">
                <button type="button" class="menu-btn" id="navToggle" aria-label="Open menu" aria-controls="side" aria-expanded="false">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                </button>
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">S</span>
                    <span>Staffroom</span>
                </a>
            </header>

            <main class="content" role="main">
                @if (TempData["Success"] is string successMessage)
                {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                }
                @RenderBody()
            </main>

            <footer class="site-foot">
                Built with ASP.NET Core and PostgreSQL.
                <a href="https://github.com/Mdmustafasalman748/Employee_Management_System_Project">View the source on GitHub</a>.
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var btn = document.getElementById('navToggle');
            var scrim = document.getElementById('scrim');
            function set(open) {
                document.body.classList.toggle('nav-open', open);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            btn.addEventListener('click', function () { set(!document.body.classList.contains('nav-open')); });
            scrim.addEventListener('click', function () { set(false); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>