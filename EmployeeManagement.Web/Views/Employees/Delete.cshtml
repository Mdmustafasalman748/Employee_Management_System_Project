@model EmployeeManagement.Web.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<h1>Delete Employee</h1>
<h4 class="text-danger">Are you sure you want to delete this employee?</h4>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department?.Name</dd>

    <dt class="col-sm-3">Monthly Salary</dt>
    <dd class="col-sm-9">@Model.MonthlySalary.ToString("N2")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>