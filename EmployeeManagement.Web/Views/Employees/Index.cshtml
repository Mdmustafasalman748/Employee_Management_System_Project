@using EmployeeManagement.Web.Helpers
@model EmployeeManagement.Web.Models.EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
}

<div class="page-head">
    <h1>Employees</h1>
</div>

<div class="toolbar">
    <form asp-action="Index" method="get" class="search">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name or email" aria-label="Search employees" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </form>
    <div class="toolbar-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="ExportCsv" asp-route-search="@Model.Search" class="btn btn-outline-success">Export CSV</a>
        }
        <a asp-action="Create" class="btn btn-primary">Add employee</a>
    </div>
</div>

<div class="panel">
    @if (!Model.Employees.Any())
    {
        <div class="empty">
            @if (string.IsNullOrWhiteSpace(Model.Search))
            {
                <p>No employees yet. Add the first one to get started.</p>
            }
            else
            {
                <p>No employees match "@Model.Search". Try a different name or email.</p>
            }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th class="num">Monthly salary</th>
                        <th>Joined</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Employees)
                    {
                        <tr>
                            <td>
                                <div class="person">
                                    <span class="avatar" style="@Ui.AvatarStyle(e.FullName)">@Ui.Initials(e.FullName)</span>
                                    <div>
                                        <b>@e.FullName</b>
                                        <small>@e.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="chip">@e.Department?.Name</span></td>
                            <td class="num">@e.MonthlySalary.ToString("N2")</td>
                            <td>@e.JoinedOn.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="acts">
                                    <a asp-action="Details" asp-route-id="@e.Id">View</a>
                                    <a asp-action="Edit" asp-route-id="@e.Id">Edit</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a class="danger" asp-action="Delete" asp-route-id="@e.Id">Delete</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<nav aria-label="Pages">
    <ul class="pagination">
        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Previous</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
        </li>
        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Next</a>
        </li>
    </ul>
</nav>