@model List<EmployeeManagement.Web.Models.Employee>
@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>
    <p><a asp-action="Create" class="btn btn-primary">Add Employee</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Monthly Salary</th>
            <th>Joined</th>
               <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FullName</td>
                <td>@e.Email</td>
                <td>@e.Department?.Name</td>
                <td>@e.MonthlySalary.ToString("N2")</td>
                <td>@e.JoinedOn.ToString("dd MMM yyyy")</td>
                 <td>
                 <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                 <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>