@model List<EmployeeManagement.Web.Models.Employee>
@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Monthly Salary</th>
            <th>Joined</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FullName</td>
                <td>@e.Email</td>
                <td>@e.Department?.Name</td>
                <td>@e.MonthlySalary.ToString("N2")</td>
                <td>@e.JoinedOn.ToString("dd MMM yyyy")</td>
            </tr>
        }
    </tbody>
</table>